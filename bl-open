#!/usr/bin/env bash
# bl-open — unlock a BitLocker USB volume and mount its plaintext, in one go.
#
# Usage:
#   ./bl-open                  # defaults to /dev/disk7s1
#   ./bl-open /dev/disk4s1
#   ./bl-open -f key.BEK       # use a BEK file instead of a password
#
# Behaviour:
#   - Prompts for your BitLocker password (or 48-digit recovery key) once.
#   - Delegates the decrypt + mount to `bl unlock`, which transports the secret
#     to dislocker securely (via a pty, never on argv) and mounts the plaintext
#     image. sudo will prompt for your macOS login password (raw disk access).
#   - Auto-detects: 48-digit "######-######-..." -> recovery key,
#                   anything else                  -> user password.
#   - Skips re-decryption if /tmp/bl/decrypted.img already exists.
#
# Why delegate to `bl`?  dislocker-file accepts only -u/-p/-f/-k/-K/-c for auth,
# and reads the user password from stdin but the recovery password from /dev/tty.
# `bl` already handles every secret type uniformly over a pty; bl-open invoking
# dislocker-file directly previously passed `bl`-only flags (--secret-file) that
# dislocker rejects, so the password/recovery paths were broken (BEK-only).

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BL="$SCRIPT_DIR/bl"

# State used by cleanup_all.
SECRET_FILE=""

# F3-02: comprehensive cleanup on all exit paths.
cleanup_all() {
  [[ -n "${SECRET_FILE:-}" ]] && rm -f "$SECRET_FILE"
  sudo -k 2>/dev/null  # invalidate cached sudo creds explicitly
}
trap 'cleanup_all' EXIT INT TERM ERR

[[ -x "$BL" ]] || { echo "error: $BL missing or not executable" >&2; exit 1; }

DEVICE="/dev/disk7s1"
BEK_FILE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -f|--bekfile) BEK_FILE="$2"; shift 2 ;;
    /dev/*)       DEVICE="$1"; shift ;;
    -h|--help)    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)            echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

[[ -b "$DEVICE" || -c "$DEVICE" ]] || { echo "error: $DEVICE is not a block/char device" >&2; exit 1; }

# Build the auth arguments for `bl unlock`.
if [[ -n "$BEK_FILE" ]]; then
  [[ -r "$BEK_FILE" ]] || { echo "error: cannot read BEK file $BEK_FILE" >&2; exit 1; }
  BL_AUTH=(--bek "$BEK_FILE")
  echo "Unlocking $DEVICE with BEK file -> decrypting + mounting..."
else
  read -rsp "BitLocker password (or 48-digit recovery key): " PASS
  echo

  # F1-01: write the secret to a mode-0600 temp file; never pass it via argv.
  SECRET_FILE="$(mktemp -t bl-secret.XXXXXXXX)"
  chmod 600 "$SECRET_FILE"
  printf '%s' "$PASS" > "$SECRET_FILE"

  if [[ "$PASS" =~ ^[0-9]{6}(-[0-9]{6}){7}$ ]]; then
    SECRET_TYPE="recovery"
  else
    SECRET_TYPE="password"
  fi
  unset PASS  # the secret now lives only in the 0600 file

  BL_AUTH=(--secret-file "$SECRET_FILE" --secret-type "$SECRET_TYPE")
  echo "Unlocking $DEVICE with $SECRET_TYPE -> decrypting + mounting..."
fi

# `bl unlock` handles sudo, secure secret transport, the decrypt progress bar,
# skip-if-present, ownership reclamation, and the hdiutil mount (printing
# "mounted at <path>"). Run it (not exec) so cleanup_all still fires.
"$BL" unlock --device "$DEVICE" "${BL_AUTH[@]}"
rc=$?

if (( rc == 0 )); then
  echo
  echo "Done. To clean up later:"
  echo "  hdiutil detach <mount-point shown above>"
  echo "  ./bl cleanup --image /tmp/bl/decrypted.img   # delete the ~128 GB plaintext copy"
  echo
  # F5-08: the image is an unencrypted copy of the volume. Time Machine skips
  # /private/tmp by default, but third-party backup tools may not.
  echo "Note: /tmp/bl/decrypted.img is UNENCRYPTED. Exclude /private/tmp/bl from any"
  echo "      third-party backup tool so the plaintext isn't copied off-box."
fi
exit "$rc"
